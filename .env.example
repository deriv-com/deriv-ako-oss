# Deriv AKO settings. `npm run setup` writes .env for you; this file shows every
# variable it can hold. Keep .env out of git: it holds secrets.

# --- GitHub App (required) ---------------------------------------------------
# Created by `npm run setup`, or by hand from manifests/github-app.json.
GITHUB_APP_ID=
# Needed for `ako login` (GitHub's device flow) in the terminal.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
# The app's private key, one of:
#   base64 of the .pem, on one line:  base64 -i app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY_BASE64=
#   or a path to the .pem file
# GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# GitHub Enterprise Server only:
# GITHUB_URL=https://github.example.com
# GITHUB_API_URL=https://github.example.com/api/v3

# --- ClickUp (only for projects on a ClickUp list) ---------------------------
# CLICKUP_API_TOKEN=

# --- AI provider (optional) --------------------------------------------------
# Lets people ask in their own words. Any OpenAI-compatible provider works.
# Without a key, AKO takes plain commands only.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AKO_AI_MODEL=

# --- Slack (optional) --------------------------------------------------------
# Bot token from OAuth & Permissions, and an app-level token with
# connections:write from Basic Information > App-Level Tokens.
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
